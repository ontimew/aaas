rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }

    match /projectStats/{projectId} {
      allow read: if true;
      allow write: if false; // Only server/cloud function should update stats securely, here we might allow client for prototype
    }
    
    // For prototype simplicity, allowing votes if signed in, mapping strictly to userId
    match /votes/{voteId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /tickets/{ticketId} {
      allow read: if true; // anyone can list tickets
      allow create: if isSignedIn() && incoming().sellerId == request.auth.uid;
      allow update: if isSignedIn(); // allow all authenticated users for prototype admin
      allow delete: if isSignedIn();
    }

    match /connections/{connectionId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
